# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# You can provide your MongoDB Atlas connection URI or local MongoDB URI.
# If left blank or MongoDB is not running locally, the server will automatically
# boot an in-memory embedded MongoDB instance for instant zero-configuration local review!
MONGO_URI=

# Authentication & Cryptographic Security Secrets
JWT_SECRET=viticket_jwt_super_secret_key_2026_vit_production
TICKET_SECRET=viticket_hmac_ticket_crypto_key_2026_super_secure

# Email Notification Service (Nodemailer / SMTP)
# Leave blank to automatically use Nodemailer Ethereal testing service with console preview links!
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="VITicket Campus Pass" <noreply@viticket.vit.ac.in>

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173
