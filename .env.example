# ========================================================
# VITicket - Environment Variables Configuration
# ========================================================

# Server Port & Mode
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
# You can supply a local MongoDB connection string or a MongoDB Atlas URI.
# If MONGO_URI is omitted or cannot be reached, VITicket automatically boots
# an embedded in-memory MongoDB instance for instant zero-configuration local review!
MONGO_URI=mongodb://localhost:27017/viticket

# Authentication & Cryptographic Security Secrets
# Used for issuing JWT session tokens
JWT_SECRET=viticket_jwt_super_secret_key_2026_vit_production

# Used for HMAC-SHA256 cryptographic signing of ticket QR tokens
TICKET_SECRET=viticket_hmac_ticket_crypto_key_2026_super_secure

# Email Notification Service (Nodemailer / SMTP)
# Leave blank to automatically activate Nodemailer Ethereal testing service.
# When using Ethereal, live email preview links will be printed directly in the terminal!
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="VITicket Campus Pass" <noreply@viticket.vit.ac.in>

# Frontend Client URL
CLIENT_URL=http://localhost:5173
